"""
refcount_demo.py

The same apple example from refcount.c, in Python.
Python does every incref and decref automatically.

Run:
    python3 refcount_demo.py
"""

import sys


class Thing:
    def __init__(self, name):
        self.name = name

    def __del__(self):
        # Runs the moment the reference count reaches 0
        print(f"  [free]    {self.name}")


# Note: sys.getrefcount reports one extra, because passing
# the object into getrefcount creates a temporary reference.
# That's why each line below subtracts 1.

print("1. Create an object:")
a = Thing("apple")
print(f"  refcount = {sys.getrefcount(a) - 1}")

print("\n2. Store it in a list (two owners now):")
box = [a]
print(f"  refcount = {sys.getrefcount(a) - 1}")

print("\n3. Delete the variable:")
del a
print(f"  refcount = {sys.getrefcount(box[0]) - 1}")

print("\n4. The list still has it:")
print(f"  box holds {box[0].name}")

print("\n5. Clear the list (last owner):")
box.clear()
